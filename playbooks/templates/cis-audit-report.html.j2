<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CIS Audit Report - {{ audit_report_summary.inventory_hostname }}</title>
  <style>
    :root {
      --bg: #f5f1e8;
      --panel: #fffaf1;
      --ink: #1f2933;
      --muted: #52606d;
      --border: #d9cbb3;
      --pass: #1f7a4d;
      --fail: #b42318;
      --review: #9a6700;
      --error: #7a1f5c;
      --accent: #8a5a2b;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", "Source Sans 3", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(138, 90, 43, 0.14), transparent 24%),
        linear-gradient(180deg, #f7f2e9 0%, #efe6d8 100%);
    }
    main {
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px 24px 48px;
    }
    .hero {
      background: linear-gradient(135deg, rgba(138, 90, 43, 0.12), rgba(255, 250, 241, 0.95));
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 18px 40px rgba(31, 41, 51, 0.08);
    }
    .eyebrow {
      margin: 0 0 8px;
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      font-weight: 700;
    }
    h1 {
      margin: 0;
      font-size: clamp(28px, 4vw, 44px);
      line-height: 1.08;
    }
    .meta {
      margin-top: 12px;
      color: var(--muted);
      font-size: 14px;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 14px;
      margin-top: 24px;
    }
    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px;
    }
    .card .label {
      display: block;
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 6px;
    }
    .card .value {
      font-size: 28px;
      font-weight: 700;
    }
    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      margin: 24px 0 16px;
    }
    input[type="search"], select {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 12px;
      background: rgba(255, 250, 241, 0.95);
      color: var(--ink);
      min-width: 220px;
    }
    .table-wrap {
      overflow: auto;
      border-radius: 18px;
      border: 1px solid var(--border);
      box-shadow: 0 18px 40px rgba(31, 41, 51, 0.08);
      background: rgba(255, 250, 241, 0.95);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 1100px;
    }
    thead th {
      position: sticky;
      top: 0;
      background: #f2e8d9;
      color: var(--ink);
      text-align: left;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
    }
    tbody td {
      padding: 14px 16px;
      border-bottom: 1px solid rgba(217, 203, 179, 0.6);
      vertical-align: top;
      font-size: 14px;
    }
    tbody tr:hover { background: rgba(138, 90, 43, 0.05); }
    .status {
      display: inline-block;
      min-width: 84px;
      text-align: center;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border: 1px solid currentColor;
      background: rgba(255, 255, 255, 0.7);
    }
    .status-pass { color: var(--pass); }
    .status-fail { color: var(--fail); }
    .status-review { color: var(--review); }
    .status-error { color: var(--error); }
    .summary {
      max-width: 520px;
      color: var(--muted);
      line-height: 1.45;
    }
    details {
      border: 1px solid rgba(217, 203, 179, 0.8);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.65);
      padding: 10px 12px;
    }
    details summary {
      cursor: pointer;
      font-weight: 600;
      color: var(--accent);
    }
    pre {
      white-space: pre-wrap;
      word-break: break-word;
      background: #faf6ef;
      border: 1px solid rgba(217, 203, 179, 0.7);
      border-radius: 10px;
      padding: 12px;
      margin: 12px 0 0;
      font-size: 12px;
      line-height: 1.45;
      color: var(--ink);
    }
    .muted { color: var(--muted); }
    @media (max-width: 760px) {
      main { padding: 20px 14px 32px; }
      .hero { padding: 18px; }
      .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body>
  <main>
    <section class="hero">
      <p class="eyebrow">Oracle CIS Audit</p>
      <h1>Audit Report for {{ audit_report_summary.inventory_hostname }}</h1>
      <div class="meta">
        Generated at {{ audit_report_summary.generated_at }}.
        Results are heuristic: explicit `PASS` and `FAIL` outputs are respected, while many `rc=1` checks remain flagged as `review`.
      </div>
      <div class="cards">
        <div class="card">
          <span class="label">Total Controls</span>
          <span class="value">{{ audit_report_summary.total }}</span>
        </div>
        <div class="card">
          <span class="label">Pass</span>
          <span class="value" style="color: var(--pass)">{{ audit_report_summary.pass }}</span>
        </div>
        <div class="card">
          <span class="label">Fail</span>
          <span class="value" style="color: var(--fail)">{{ audit_report_summary.fail }}</span>
        </div>
        <div class="card">
          <span class="label">Review</span>
          <span class="value" style="color: var(--review)">{{ audit_report_summary.review }}</span>
        </div>
        <div class="card">
          <span class="label">Execution Errors</span>
          <span class="value" style="color: var(--error)">{{ audit_report_summary.error }}</span>
        </div>
      </div>
    </section>

    <div class="controls">
      <input id="searchBox" type="search" placeholder="Filter by control, title, summary or output">
      <select id="statusFilter">
        <option value="">All statuses</option>
        <option value="pass">Pass</option>
        <option value="fail">Fail</option>
        <option value="review">Review</option>
        <option value="error">Error</option>
      </select>
      <span id="visibleCount" class="muted"></span>
    </div>

    <div class="table-wrap">
      <table id="auditTable">
        <thead>
          <tr>
            <th>Control</th>
            <th>Title</th>
            <th>Status</th>
            <th>RC</th>
            <th>Summary</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          {% for item in audit_report_items %}
          <tr data-status="{{ item.status }}" data-search="{{ (item.control_id ~ ' ' ~ item.title ~ ' ' ~ item.summary ~ ' ' ~ item.stdout ~ ' ' ~ item.stderr) | lower | replace('\n', ' ') | replace('\r', ' ') }}">
            <td><strong>{{ item.control_id }}</strong></td>
            <td>{{ item.title }}</td>
            <td>
              <span class="status status-{{ item.status }}">{{ item.status }}</span>
            </td>
            <td>{{ item.rc }}</td>
            <td class="summary">{{ item.summary }}</td>
            <td>
              <details>
                <summary>Show command output</summary>
                {% if item.stdout %}
                <pre><strong>stdout</strong>
{{ item.stdout }}</pre>
                {% endif %}
                {% if item.stderr %}
                <pre><strong>stderr</strong>
{{ item.stderr }}</pre>
                {% endif %}
                {% if item.cmd %}
                <pre><strong>command</strong>
{{ item.cmd }}</pre>
                {% endif %}
                <pre><strong>timing</strong>
start={{ item.start }}
end={{ item.end }}
delta={{ item.delta }}</pre>
              </details>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </main>
  <script>
    const searchBox = document.getElementById('searchBox');
    const statusFilter = document.getElementById('statusFilter');
    const rows = Array.from(document.querySelectorAll('#auditTable tbody tr'));
    const visibleCount = document.getElementById('visibleCount');

    function updateRows() {
      const term = searchBox.value.trim().toLowerCase();
      const status = statusFilter.value;
      let shown = 0;
      rows.forEach((row) => {
        const matchesText = !term || row.dataset.search.includes(term);
        const matchesStatus = !status || row.dataset.status === status;
        const visible = matchesText && matchesStatus;
        row.style.display = visible ? '' : 'none';
        if (visible) shown += 1;
      });
      visibleCount.textContent = `${shown} visible control(s)`;
    }

    searchBox.addEventListener('input', updateRows);
    statusFilter.addEventListener('change', updateRows);
    updateRows();
  </script>
</body>
</html>
